FROM node:20-bookworm-slim

RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends \
       build-essential python3 curl openssl ca-certificates procps wireguard-tools iproute2 iptables \
    && rm -rf /var/lib/apt/lists/*

# wg-quick calls 'resolvconf -a <iface> -m 0 -x' / 'resolvconf -d <iface>' to manage DNS for the
# tunnel — the real resolvconf package can't be installed here: its postinst tries to replace
# /etc/resolv.conf with a symlink, which fails ("Device or resource busy") because Docker bind-
# mounts that file. Docker already manages DNS for the container on its own, so a no-op stub
# (same calling convention, does nothing) is enough for wg-quick to proceed past this step. Same
# fix already applied in Dockerfile.node-agent.
RUN printf '#!/bin/sh\nexit 0\n' > /usr/bin/resolvconf && chmod +x /usr/bin/resolvconf

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm install --omit=dev --no-audit --no-fund

COPY . .
RUN mkdir -p public/vendor \
    && cp node_modules/chart.js/dist/chart.umd.js public/vendor/chart.js \
    && cp node_modules/@xterm/xterm/lib/xterm.js public/vendor/xterm.js \
    && cp node_modules/@xterm/xterm/css/xterm.css public/vendor/xterm.css

COPY docker/entrypoint-dashboard.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && mkdir -p /app/data /app/certs

ENV PORT=8080
ENV SSL_CERT=/app/certs/cert.pem
ENV SSL_KEY=/app/certs/key.pem
EXPOSE 8080
ENTRYPOINT ["/entrypoint.sh"]
